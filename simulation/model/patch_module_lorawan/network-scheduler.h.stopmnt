#ifndef NETWORK_SCHEDULER_H
#define NETWORK_SCHEDULER_H

#include "ns3/nstime.h"
#include "ns3/random-variable-stream.h"

#include <deque>
#include <vector>
#include "ns3/object.h"
#include "ns3/packet.h"
#include "ns3/traced-callback.h"

namespace ns3
{
namespace lorawan
{

class NetworkController;
class NetworkStatus;
class LoraDeviceAddress;

/**
 * @ingroup lorawan
 *
 * Network server component in charge of scheduling downling packets onto devices' reception windows
 *
 * @todo We should probably add getters and setters or remove default constructor
 */
class NetworkScheduler : public Object
{
  public:
    /**
     *  Register this type.
     *  @return The object TypeId.
     */
    static TypeId GetTypeId();

    NetworkScheduler();           //!< Default constructor
    ~NetworkScheduler() override; //!< Destructor

    /**
     * Construct a new NetworkScheduler providing the NetworkStatus and the NetworkController
     * objects.
     *
     * @param status A pointer to the NetworkStatus object.
     * @param controller A pointer to the NetworkController object.
     */
    NetworkScheduler(Ptr<NetworkStatus> status, Ptr<NetworkController> controller);

    /**
     * Method called by NetworkServer application to inform the Scheduler of a newly arrived uplink
     * packet.
     *
     * This function schedules the OnReceiveWindowOpportunity events 1 and 2 seconds later.
     *
     * @param packet A pointer to the new Packet instance.
     */
    void OnReceivedPacket(Ptr<const Packet> packet);

    /**
     * Method that is scheduled after packet arrival in order to take action on
     * sender's receive windows openings.
     *
     * @param deviceAddress The Address of the end device.
     * @param window The reception window number (1 or 2).
     */
    void OnReceiveWindowOpportunity(LoraDeviceAddress deviceAddress, int window);

  private:
    TracedCallback<Ptr<const Packet>>
        m_receiveWindowOpened;           //!< Trace callback source for reception windows openings.
                                         //!< \todo Never called. Place calls in the right places.
    Ptr<NetworkStatus> m_status;         //!< A pointer to the NetworkStatus object.
    Ptr<NetworkController> m_controller; //!< A pointer to the NetworkController object.
    // STOP-MNT (ajout local, desactive par defaut) : choix de la fenetre de
    // reponse selon le bilan de liaison prevu en RX1.
    bool m_rx1BudgetCheck = false;  //!< Passer en RX2 si RX1 ne porte pas
    double m_edTxPowerDbm = 14;     //!< Puissance d'emission des noeuds (montante)
    double m_gwRxGainDb = 0;        //!< Gain d'antenne passerelle en reception
    double m_rx1PowerDbm = 14;      //!< Puissance d'emission passerelle en RX1
    double m_rx1MarginDb = 0;       //!< Marge exigee en RX1
    Time m_rx1Delay = Seconds(1);   //!< STOP-MNT : instant de la reponse RX1 apres reception
    // STOP-MNT (ajout local, desactive par defaut) : remontee passerelle-serveur
    // realiste (latence aleatoire, pics, retransmissions TCP, deduplication du
    // serveur, estimation de l'aller-retour, rejet TOO_LATE de la passerelle).
    bool m_bhModel = false;
    double m_bhMedianMs = 20;       //!< mediane de la latence aller simple
    double m_bhSigma = 0.5;         //!< ecart-type du logarithme (loi log-normale)
    double m_bhSpikeProb = 0;       //!< probabilite d'un pic par trajet
    double m_bhSpikeMinS = 1;       //!< bornes du retard d'un pic
    double m_bhSpikeMaxS = 6;
    double m_bhLossProb = 0;        //!< perte TCP par trajet, rattrapee apres un RTO
    double m_bhRtoMs = 200;         //!< RTO minimal
    double m_dedupMs = 200;         //!< attente de deduplication du serveur
    double m_tooLateMs = 42.5;      //!< marge du JIT de la passerelle
    uint32_t m_rttWindow = 20;      //!< echantillons d'aller-retour gardes
    uint32_t m_rttMinSamples = 5;   //!< minimum pour utiliser l'estimation
    std::deque<double> m_rttHist;   //!< aller-retours recents (s)
    Ptr<UniformRandomVariable> m_bhUni;
    Ptr<NormalRandomVariable> m_bhNorm;
    double DrawOneWay();

  public:
    // Compteurs de la remontee (lus par le scenario en fin de run).
    static uint32_t s_bhReplies;     //!< reponses a envoyer (accuses ou commandes)
    static uint32_t s_bhRx1;         //!< parties en RX1
    static uint32_t s_bhRx2Target;   //!< visees directement en RX2 (estimation trop longue)
    static uint32_t s_bhRx2Fallback; //!< RX1 trop tard (TOO_LATE), rattrapees en RX2
    static uint32_t s_bhLost;        //!< trop tard pour les deux fenetres
    static std::vector<double> s_bhRtt; //!< aller-retours tires (s)
};

} // namespace lorawan
} // namespace ns3

#endif /* NETWORK_SCHEDULER_H */
