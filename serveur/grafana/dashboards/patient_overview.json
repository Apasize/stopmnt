{
  "title": "STOP-MNT — Vue Patient",
  "uid": "stopmnt-patient",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Fréquence Cardiaque",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "influxdb", "uid": "InfluxDB-STOPMNT"},
      "fieldConfig": {
        "defaults": {
          "unit": "bpm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 100},
              {"color": "red", "value": 120}
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "influxdb", "uid": "InfluxDB-STOPMNT"},
          "query": "from(bucket: \"physiological_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ppg\")\n  |> filter(fn: (r) => r._field == \"fc\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "id": 2,
      "title": "SpO2",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "influxdb", "uid": "InfluxDB-STOPMNT"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 85,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 94},
              {"color": "green", "value": 96}
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "influxdb", "uid": "InfluxDB-STOPMNT"},
          "query": "from(bucket: \"physiological_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ppg\")\n  |> filter(fn: (r) => r._field == \"spo2\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Alertes récentes",
      "type": "table",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "postgres", "uid": "PostgreSQL-STOPMNT"},
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT timestamp, patient_id, capteur, niveau, message, acquittee FROM alertes ORDER BY timestamp DESC LIMIT 20",
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "title": "Mesures discrètes",
      "type": "table",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "postgres", "uid": "PostgreSQL-STOPMNT"},
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT timestamp_data, patient_id, capteur, mesures, anomalie FROM mesures_discretes ORDER BY timestamp_data DESC LIMIT 20",
          "format": "table"
        }
      ]
    }
  ]
}
