{
  "title": "STOP-MNT — Épidémiologie",
  "uid": "stopmnt-epidemio",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "5m",
  "time": {"from": "now-7d", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Patients par département",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "postgres", "uid": "PostgreSQL-STOPMNT"},
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT departement, COUNT(*) as nb_patients FROM patients WHERE actif = TRUE GROUP BY departement ORDER BY nb_patients DESC",
          "format": "table"
        }
      ]
    },
    {
      "id": 2,
      "title": "Alertes par niveau",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "postgres", "uid": "PostgreSQL-STOPMNT"},
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT departement, niveau, COUNT(*) as nb FROM alertes WHERE timestamp > NOW() - INTERVAL '7 days' GROUP BY departement, niveau ORDER BY departement",
          "format": "table"
        }
      ]
    },
    {
      "id": 3,
      "title": "Anomalies par capteur",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "postgres", "uid": "PostgreSQL-STOPMNT"},
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT capteur, COUNT(*) as nb_anomalies FROM mesures_discretes WHERE anomalie = TRUE GROUP BY capteur ORDER BY nb_anomalies DESC",
          "format": "table"
        }
      ]
    }
  ]
}
